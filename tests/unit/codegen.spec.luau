local codegen = require '@lib/codegen'
local expect = require '@test/expect'
local product = require '@lib/resources/product'

local run = {}

function run.generates_ids_and_nested_assets()
	local lock: any = {
		universe_id = 1,
		places = { start = { place_id = 2 } },
		products = { yens1 = { product_id = 3 } },
		passes = { vip = { pass_id = 4 } },
		thumbnails = {},
		configs = {},
	}
	local assets: any = {
		['hover.ogg'] = { asset_id = 5 },
		['sounds/Shoe 1.ogg'] = { asset_id = 6 },
		['ui/btn.png'] = { uri = 'rbxasset://ro-sync/h8.png' },
	}
	expect.eq(
		codegen.generate(lock, assets),
		table.concat({
			'-- This file is automatically @generated by ro-sync.',
			'-- It is not intended for manual editing.',
			'export type place = { place_id: number, data: {} }',
			'export type product = { product_id: number, data: {} }',
			'export type pass = { pass_id: number, data: {} }',
			'',
			'return {',
			'\tuniverse_id = 1,',
			'\tplaces = {',
			'\t\tstart = { place_id = 2, data = {} },',
			'\t},',
			'\tproducts = {',
			'\t\tyens1 = { product_id = 3, data = {} },',
			'\t},',
			'\tpasses = {',
			'\t\tvip = { pass_id = 4, data = {} },',
			'\t},',
			'\tassets = {',
			'\t\thover = Content.fromUri("rbxassetid://5"),',
			'\t\tsounds = {',
			'\t\t\t["Shoe 1"] = Content.fromUri("rbxassetid://6"),',
			'\t\t},',
			'\t\tui = {',
			'\t\t\tbtn = Content.fromUri("rbxasset://ro-sync/h8.png"),',
			'\t\t},',
			'\t},',
			'}',
			'',
		}, '\n')
	)
end

function run.staged_resources_get_negative_ids_and_input_over_template()
	local created = product.stage({ name = 'Local', conflicts = {} }, {
		universe_id = 1,
		product_id = 3,
		-- locks written before get stopped returning identity still carry it in their input
		input = { name = 'Cloud', price = 10, icon_file = { hash = 'h' }, universe_id = 1, product_id = 3 },
	})
	local lock: any = {
		universe_id = 1,
		places = {},
		passes = {},
		products = {
			a_new = product.stage({ name = 'New', conflicts = {} }, nil),
			b_new = product.stage({ name = 'Other', conflicts = {} }, nil),
			yens = created,
		},
	}
	local code = codegen.generate(lock)

	expect.truthy(
		code:find('export type product = { product_id: number, data: { name: string?, price: number? } }', 1, true),
		code
	)
	expect.truthy(code:find('a_new = { product_id = -1, data = { name = "New" } }', 1, true), code)
	expect.truthy(code:find('b_new = { product_id = -2, data = { name = "Other" } }', 1, true), code)
	expect.truthy(code:find('yens = { product_id = 3, data = { name = "Local", price = 10 } }', 1, true), code)
end

function run.registers_staged_animations_from_the_game()
	local lock: any = {
		universe_id = 1,
		places = {},
		products = {},
		passes = {},
	}
	local code =
		codegen.generate(lock, { ['npc/Walk Fast.rbxm'] = { keyframe_root = { 'ReplicatedStorage', 'Animations' } } })

	local provider = 'local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")'
	local path = 'game:GetService("ReplicatedStorage"):FindFirstChild("Animations")'
		.. ':FindFirstChild("npc"):FindFirstChild("Walk Fast")'
	expect.truthy(code:find(provider, 1, true), code)
	expect.truthy(
		code:find(`["Walk Fast"] = Content.fromUri(KeyframeSequenceProvider:RegisterKeyframeSequence({path}))`, 1, true),
		code
	)
end

function run.identity_left_in_legacy_input_stays_out_of_data()
	local lock: any = {
		universe_id = 1,
		places = {},
		products = {},
		passes = { vip = { universe_id = 1, pass_id = 4, input = { name = 'VIP', universe_id = 1, pass_id = 4 } } },
	}
	local code = codegen.generate(lock)

	expect.truthy(code:find('vip = { pass_id = 4, data = { name = "VIP" } }', 1, true), code)
end

return run
