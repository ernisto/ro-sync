local codegen = require '@lib/codegen'
local expect = require '@test/expect'

local run = {}

function run.generates_ids()
	local lock: any = {
		universe_id = 1,
		places = { start = { place_id = 2 } },
		products = { yens1 = { product_id = 3 } },
		passes = { vip = { pass_id = 4 } },
		thumbnails = {},
		configs = {},
	}
	expect.eq(
		codegen.generate(lock),
		table.concat({
			'-- This file is automatically @generated by ro-sync.',
			'-- It is not intended for manual editing.',
			'return {',
			'\tuniverse_id = 1,',
			'\tplaces = {',
			'\t\tstart = { place_id = 2 },',
			'\t},',
			'\tproducts = {',
			'\t\tyens1 = { product_id = 3 },',
			'\t},',
			'\tpasses = {',
			'\t\tvip = { pass_id = 4 },',
			'\t},',
			'}',
			'',
		}, '\n')
	)
end

return run
