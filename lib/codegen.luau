local state = require './state'

-- functions
local function is_identifier(key: string): boolean
	return string.match(key, '^[%a_][%w_]*$') ~= nil
end

local function key_of(key: string): string
	return if is_identifier(key) then key else string.format('[%q]', key)
end

local function sorted_keys(t: { [string]: any }): { string }
	local keys = {}
	for key in t do
		table.insert(keys, key)
	end
	table.sort(keys)
	return keys
end

local function emit_ids(out: { string }, name: string, locks: { [string]: any }, field: string)
	table.insert(out, `\t{name} = \{\n`)
	for _, key in sorted_keys(locks) do
		table.insert(out, `\t\t{key_of(key)} = \{ {field} = {locks[key][field]} },\n`)
	end
	table.insert(out, '\t},\n')
end

local function generate(lock: state.lock): string
	local out = {
		'-- This file is automatically @generated by ro-sync.\n',
		'-- It is not intended for manual editing.\n',
		'return {\n',
		`\tuniverse_id = {lock.universe_id},\n`,
	}
	emit_ids(out, 'places', lock.places, 'place_id')
	emit_ids(out, 'products', lock.products, 'product_id')
	emit_ids(out, 'passes', lock.passes, 'pass_id')
	table.insert(out, '}\n')
	return table.concat(out)
end

-- module
return table.freeze { generate = generate }
