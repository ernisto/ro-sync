{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ro-sync/manifest.schema.json",
  "title": "ro-sync manifest",
  "description": "User-edited list of products/places/universe synced to Roblox via Open Cloud.",
  "type": "object",
  "required": ["version", "owner"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Manifest format version. Must be 1.",
      "const": 1
    },
    "owner": { "$ref": "#/definitions/owner" },
    "universe": { "$ref": "#/definitions/universe" },
    "places": {
      "description": "Map of place key -> place config.",
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/place" }
    },
    "products": {
      "description": "Map of product key -> developer product config.",
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/product" }
    },
    "passes": {
      "description": "Map of pass key -> game pass config.",
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/pass" }
    },
    "thumbnails": {
      "description": "Ordered list of universe thumbnail images. When set, images removed from the list are deleted from Roblox (only ones uploaded by ro-sync). Omit to leave thumbnails unmanaged.",
      "type": "array",
      "items": { "$ref": "#/definitions/thumbnail" }
    },
    "icon": {
      "description": "Universe (game) icon image.",
      "$ref": "#/definitions/thumbnail"
    },
    "configs": {
      "description": "Map of in-experience config key -> config. Values are never synced: missing keys are created with the type's zero value, tune values in Creator Hub or in game.",
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/config" }
    },
    "assets": {
      "description": "Files uploaded as Roblox assets (images, audio, models, animations, videos), stored in the lock as a tree by path (relative to the glob root, extensions stripped) of `{ asset_id, hash }`: files with an already uploaded hash (unchanged, renamed, duplicated) are never re-uploaded. Owned by `owner`. Transparent png pixels are alpha-bled before upload.",
      "type": "object",
      "required": ["files"],
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "string",
          "description": "Glob of files to upload, supports `*`, `?`, `**` and `{a,b}`. Example: `assets/{images,sounds}/**`."
        },
        "animations": {
          "type": "string",
          "description": "Dot path of the game folder holding the animations with the same hierarchy as the glob root, e.g. `ReplicatedStorage.Animations`. `codegen` registers animations not uploaded yet from there with KeyframeSequenceProvider (Studio only)."
        }
      }
    }
  },
  "definitions": {
    "config": {
      "description": "In-experience config entry (ConfigService).",
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "Value type, used to pick the zero value on creation.",
          "enum": ["json", "string", "number", "boolean"]
        },
        "description": {
          "description": "Read-only: Open Cloud can't write descriptions, set it in Creator Hub. Filled on import.",
          "type": "string"
        },
        "conflicts": { "type": "object" }
      }
    },
    "owner": {
      "description": "Resource owner. Set exactly one of user/group.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": { "type": "integer", "description": "Owner user id." },
        "group": { "type": "integer", "description": "Owner group id." }
      },
      "oneOf": [
        { "required": ["user"], "not": { "required": ["group"] } },
        { "required": ["group"], "not": { "required": ["user"] } }
      ]
    },

    "social_link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "uri": { "type": "string" }
      }
    },

    "product": {
      "description": "Developer product. Only `name` is required.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "icon": {
          "type": "string",
          "description": "Path to icon image file."
        },
        "price": {
          "type": "integer",
          "description": "Price in Robux."
        },
        "description": { "type": "string" },
        "is_for_sale": { "type": "boolean" },
        "regional_pricing": { "type": "boolean" },
        "store_page_enabled": { "type": "boolean" },
        "addons": {
          "description": "Free-form user metadata. Ignored by sync.",
          "type": "object"
        },
        "conflicts": {
          "description": "Auto-generated by sync. Do not edit by hand.",
          "type": "object"
        }
      }
    },

    "pass": {
      "description": "Game pass. Only `name` is required.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "icon": {
          "type": "string",
          "description": "Path to icon image file."
        },
        "price": {
          "type": "integer",
          "description": "Price in Robux."
        },
        "description": { "type": "string" },
        "is_for_sale": { "type": "boolean" },
        "regional_pricing": { "type": "boolean" },
        "addons": {
          "description": "Free-form user metadata. Ignored by sync.",
          "type": "object"
        },
        "conflicts": {
          "description": "Auto-generated by sync. Do not edit by hand.",
          "type": "object"
        }
      }
    },

    "thumbnail": {
      "description": "Universe thumbnail image.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to thumbnail image file."
        },
        "conflicts": {
          "description": "Auto-generated by sync. Do not edit by hand.",
          "type": "object"
        }
      }
    },

    "place": {
      "description": "Open Cloud place fields. Develop-API settings live under `configuration:`.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to the .rbxl/.rbxlx place file."
        },
        "display_name": { "type": "string" },
        "description": { "type": "string" },
        "server_size": {
          "type": "integer",
          "description": "Max player count."
        },
        "configuration": { "$ref": "#/definitions/place_configuration" },
        "conflicts": {
          "description": "Auto-generated by sync. Do not edit by hand.",
          "type": "object"
        }
      }
    },

    "place_configuration": {
      "description": "Place configuration (develop API), synced as its own resource.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "social_slot_type": {
          "type": "string",
          "enum": ["Automatic", "None", "Custom"]
        },
        "custom_social_slots_count": { "type": "integer" },
        "allow_copying": { "type": "boolean" },
        "is_all_genres_allowed": { "type": "boolean" },
        "conflicts": {
          "description": "Auto-generated by sync. Do not edit by hand.",
          "type": "object"
        }
      }
    },

    "avatar_scales": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "height": { "type": "number" },
        "width": { "type": "number" },
        "head": { "type": "number" },
        "depth": { "type": "number" },
        "proportion": { "type": "number" },
        "body_type": { "type": "number" }
      }
    },

    "universe_configuration": {
      "description": "Universe configuration (develop API), synced as its own resource. Avatar, permission, description and promotional fields are write-only: the cloud never echoes them back.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "genre": { "type": "integer" },
        "promotional_text": { "type": "string" },
        "allow_private_servers": { "type": "boolean" },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "third_party_teleport_allowed": { "type": "boolean" },
            "third_party_asset_allowed": { "type": "boolean" },
            "third_party_purchase_allowed": { "type": "boolean" },
            "client_teleport_allowed": { "type": "boolean" }
          }
        },
        "fiat_base_price_id": { "type": "string" },
        "fiat_product_change_type": { "type": "integer" },

        "price": { "type": "integer" },
        "is_for_sale": { "type": "boolean" },
        "is_archived": { "type": "boolean" },
        "is_friends_only": { "type": "boolean" },
        "audiences": { "type": "array", "items": { "type": "integer" } },
        "demo_mode_enabled": { "type": "boolean" },

        "engine_avatar_settings": { "type": "string" },
        "avatar_type": { "type": "integer" },
        "animation_type": { "type": "integer" },
        "collision_type": { "type": "integer" },
        "joint_positioning_type": { "type": "integer" },
        "avatar_asset_overrides": {
          "description": "Asset type -> override. Unlisted Enum.AssetType ids use `asset_type_<id>`.",
          "type": "object",
          "propertyNames": {
            "pattern": "^(t_shirt|shirt|pants|head|face|torso|right_arm|left_arm|left_leg|right_leg|asset_type_[0-9]+)$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset_id"],
            "properties": {
              "asset_id": { "type": "integer" },
              "player_choice": { "type": "boolean" }
            }
          }
        },
        "avatar_min_scales": { "$ref": "#/definitions/avatar_scales" },
        "avatar_max_scales": { "$ref": "#/definitions/avatar_scales" },

        "is_mesh_texture_api_access_allowed": { "type": "boolean" },
        "is_rewarded_on_demand_ads_allowed": { "type": "boolean" },
        "studio_access_to_apis_allowed": { "type": "boolean" },

        "conflicts": {
          "description": "Auto-generated by sync. Do not edit by hand.",
          "type": "object"
        }
      }
    },

    "universe": {
      "description": "Open Cloud universe fields. Socials nest under `socials:`, devices under `devices:`, develop-API settings under `configuration:`.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "private_server_price": { "type": "integer" },
        "voice_chat": { "type": "boolean" },
        "configuration": { "$ref": "#/definitions/universe_configuration" },

        "socials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "facebook": { "$ref": "#/definitions/social_link" },
            "twitter": { "$ref": "#/definitions/social_link" },
            "youtube": { "$ref": "#/definitions/social_link" },
            "twitch": { "$ref": "#/definitions/social_link" },
            "discord": { "$ref": "#/definitions/social_link" },
            "roblox_group": { "$ref": "#/definitions/social_link" },
            "guilded": { "$ref": "#/definitions/social_link" }
          }
        },
        "devices": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "desktop": { "type": "boolean" },
            "mobile": { "type": "boolean" },
            "tablet": { "type": "boolean" },
            "console": { "type": "boolean" },
            "vr": { "type": "boolean" }
          }
        },

        "conflicts": {
          "description": "Auto-generated by sync. Do not edit by hand.",
          "type": "object"
        }
      }
    }
  }
}
