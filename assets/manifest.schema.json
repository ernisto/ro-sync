{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ro-sync/manifest.schema.json",
  "title": "ro-sync manifest",
  "description": "User-edited list of products/places/universe synced to Roblox via Open Cloud.",
  "type": "object",
  "required": ["version", "owner"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Manifest format version. Must be 1.",
      "const": 1
    },
    "owner": { "$ref": "#/definitions/owner" },
    "universe": { "$ref": "#/definitions/universe" },
    "places": {
      "description": "Map of place key -> place config.",
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/place" }
    },
    "products": {
      "description": "Map of product key -> developer product config.",
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/product" }
    }
  },
  "definitions": {
    "owner": {
      "description": "Resource owner. Set exactly one of user/group.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": { "type": "integer", "description": "Owner user id." },
        "group": { "type": "integer", "description": "Owner group id." }
      },
      "oneOf": [
        { "required": ["user"], "not": { "required": ["group"] } },
        { "required": ["group"], "not": { "required": ["user"] } }
      ]
    },

    "social_link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "uri": { "type": "string" }
      }
    },

    "product": {
      "description": "Developer product. Only `name` is required.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "icon": {
          "type": "string",
          "description": "Path to icon image file."
        },
        "price": {
          "type": "integer",
          "description": "Price in Robux."
        },
        "description": { "type": "string" },
        "is_for_sale": { "type": "boolean" },
        "regional_pricing": { "type": "boolean" },
        "store_page_enabled": { "type": "boolean" },
        "addons": {
          "description": "Free-form user metadata. Ignored by sync.",
          "type": "object"
        },
        "conflicts": {
          "description": "Auto-generated by sync. Do not edit by hand.",
          "type": "object"
        }
      }
    },

    "place": {
      "description": "Place / place_configuration fields.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to the .rbxl/.rbxlx place file."
        },
        "display_name": { "type": "string" },
        "description": { "type": "string" },
        "server_size": {
          "type": "integer",
          "description": "Max player count."
        },
        "social_slot_type": {
          "type": "string",
          "enum": ["Automatic", "None", "Custom"]
        },
        "custom_social_slots_count": { "type": "integer" },
        "allow_copying": { "type": "boolean" },
        "allowed_gear_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "is_all_genres_allowed": { "type": "boolean" },
        "conflicts": {
          "description": "Auto-generated by sync. Do not edit by hand.",
          "type": "object"
        }
      }
    },

    "universe": {
      "description": "Universe fields. Socials nest under `socials:`, devices under `devices:`.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "private_server_price": { "type": "integer" },
        "voice_chat": { "type": "boolean" },

        "is_for_sale": { "type": "boolean" },
        "price": { "type": "integer" },
        "allow_private_servers": { "type": "boolean" },
        "genre": { "type": "string" },
        "is_friends_only": { "type": "boolean" },
        "is_archived": { "type": "boolean" },
        "studio_access_to_apis_allowed": { "type": "boolean" },
        "is_mesh_texture_api_access_allowed": { "type": "boolean" },

        "socials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "facebook": { "$ref": "#/definitions/social_link" },
            "twitter": { "$ref": "#/definitions/social_link" },
            "youtube": { "$ref": "#/definitions/social_link" },
            "twitch": { "$ref": "#/definitions/social_link" },
            "discord": { "$ref": "#/definitions/social_link" },
            "roblox_group": { "$ref": "#/definitions/social_link" },
            "guilded": { "$ref": "#/definitions/social_link" }
          }
        },
        "devices": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "desktop": { "type": "boolean" },
            "mobile": { "type": "boolean" },
            "tablet": { "type": "boolean" },
            "console": { "type": "boolean" },
            "vr": { "type": "boolean" }
          }
        },

        "conflicts": {
          "description": "Auto-generated by sync. Do not edit by hand.",
          "type": "object"
        }
      }
    }
  }
}
